{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Gomobile Documentation",
  "description": "Learn how to manage contacts, build multichannel experiences, launch campaigns, configure AI voice agents, and integrate with the Gomobile API.",
  "colors": {
    "primary": "#1D4ED8",
    "light": "#5164F1",
    "dark": "#1A33EE"
  },
  "logo": {
    "light": "/assets/gomobile-logo.svg",
    "dark": "/assets/gomobile-logo-dark.svg"
  },
  "favicon": "/assets/gomobile-favicon.svg",
  "appearance": {
    "default": "light",
    "strict": false
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#050607"
    }
  },
  "fonts": {
    "family": "Karla"
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "system"
  },
  "search": {
    "prompt": "Search"
  },
  "seo": {
    "indexing": "navigable",
    "organization": {
      "name": "Gomobile",
      "url": "https://gomobile.ma"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ],
    "display": "header"
  },
  "markdown": {
    "instructions": [
      "Use Gomobile customer-facing vocabulary.",
      "Do not infer support for internal, hidden, experimental, or unreleased features."
    ]
  },
  "errors": {
    "404": {
      "redirect": false,
      "title": "Page not found",
      "description": "The page may have moved. Use search or return to the [documentation home](/)."
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Learn",
        "icon": "book-open",
        "groups": [
          {
            "group": "Introduction",
            "pages": [
              "index",
              "product/overview",
              "product/how-gomobile-works"
            ]
          },
          {
            "group": "Core concepts",
            "pages": [
              "learn/concepts/organizations",
              "learn/concepts/contacts",
              "learn/concepts/audiences",
              "learn/concepts/flows",
              "learn/concepts/campaigns",
              "learn/concepts/runs",
              "learn/concepts/channels",
              "learn/concepts/whatsapp",
              "learn/concepts/agents",
              "learn/concepts/knowledge-bases",
              "learn/concepts/inbound",
              "learn/concepts/audio",
              "learn/concepts/reporting",
              "learn/concepts/credits",
              "learn/concepts/access"
            ]
          },
          {
            "group": "Platform overview",
            "pages": [
              "learn/architecture",
              "getting-started/workspace-tour",
              "product/campaign-lifecycle",
              "product/responsible-use"
            ]
          }
        ]
      },
      {
        "tab": "Build",
        "icon": "hammer",
        "groups": [
          {
            "group": "Quickstarts",
            "pages": [
              "getting-started/set-up-account",
              "quickstarts/send-sms",
              "quickstarts/make-call",
              "quickstarts/create-contact",
              "quickstarts/create-audience",
              "getting-started/build-first-flow",
              "getting-started/launch-first-campaign",
              "quickstarts/ai-voice-agent"
            ]
          },
          {
            "group": "AI tools",
            "pages": [
              "guides/ai-tools/overview",
              "guides/ai-tools/installation",
              "guides/ai-tools/usage"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "getting-started/import-contacts",
              "guides/appointment-reminders",
              "guides/payment-reminders",
              "guides/customer-surveys",
              "guides/lead-qualification",
              "guides/retry-failed-calls",
              "guides/large-audience-campaigns"
            ]
          }
        ]
      },
      {
        "tab": "Reference",
        "icon": "square-terminal",
        "groups": [
          {
            "group": "API essentials",
            "pages": [
              "developers/overview",
              "developers/authentication",
              "developers/api-basics",
              "developers/support-boundary",
              "developers/pagination",
              "developers/filtering",
              "developers/rate-limits",
              "developers/errors",
              "developers/versioning"
            ]
          },
          {
            "group": "API reference",
            "pages": [
              "developers/reference/contacts",
              "developers/reference/audiences",
              "developers/reference/flows",
              "developers/reference/campaigns",
              "developers/reference/runs-and-calls",
              "developers/reference/inbound",
              "developers/reference/agents",
              "developers/reference/knowledge-bases",
              "developers/reference/whatsapp",
              "developers/reference/audio-and-dictionaries",
              "developers/reference/credits",
              "developers/reference/endpoint-catalog"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Get API key",
      "href": "/developers/authentication#create-a-key"
    }
  }
}
